  "components": {
    "schemas": {
      "Body_create_job_jobs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_job_jobs_post"
      },
      "Body_process_document_process_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_process_document_process_post"
      },
      "ClassificationResult": {
        "properties": {
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "doc_type",
          "confidence",
          "method"
        ],
        "title": "ClassificationResult"
      },
      "DocType": {
        "type": "string",
        "enum": [
          "invoice",
          "receipt",
          "contract",
          "purchase_order",
          "bank_statement",
          "acceptance_act",
          "waybill",
          "boarding_pass",
          "unknown"
        ],
        "title": "DocType"
      },
      "DocumentForensicReport": {
        "properties": {
          "has_signatures": {
            "type": "boolean",
            "title": "Has Signatures",
            "description": "Whether at least one handwritten signature is present.",
            "default": false
          },
          "has_stamps": {
            "type": "boolean",
            "title": "Has Stamps",
            "description": "Whether at least one seal or official stamp is present.",
            "default": false
          },
          "is_executed": {
            "type": "boolean",
            "title": "Is Executed",
            "description": "Whether the document appears legally executed (signed/stamped).",
            "default": false
          },
          "is_empty_template": {
            "type": "boolean",
            "title": "Is Empty Template",
            "description": "Whether the document appears to be an unexecuted blank template.",
            "default": false
          },
          "stamps": {
            "items": {
              "$ref": "#/components/schemas/StampDetection"
            },
            "type": "array",
            "title": "Stamps"
          },
          "signatures": {
            "items": {
              "$ref": "#/components/schemas/SignatureDetection"
            },
            "type": "array",
            "title": "Signatures"
          },
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/HandwrittenAnnotation"
            },
            "type": "array",
            "title": "Annotations"
          },
          "alterations_detected": {
            "type": "boolean",
            "title": "Alterations Detected",
            "description": "Whether handwritten overrides or crossed-out amounts were detected.",
            "default": false
          },
          "risk_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risk Flags",
            "description": "Forensic risk flags (e.g. UNEXECUTED_TEMPLATE, MISSING_STAMP, HANDWRITTEN_ALTERATION)."
          }
        },
        "type": "object",
        "title": "DocumentForensicReport",
        "description": "Forensic report covering physical execution, stamps, signatures, and alterations."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandwrittenAnnotation": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "1-indexed page number."
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Transcribed or recognized text."
          },
          "annotation_type": {
            "type": "string",
            "title": "Annotation Type",
            "description": "Classification (e.g. payment_stamp, price_correction, approval, marginalia)."
          },
          "box": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Box",
            "description": "Normalized bounding box if isolated."
          }
        },
        "type": "object",
        "required": [
          "page",
          "text",
          "annotation_type"
        ],
        "title": "HandwrittenAnnotation",
        "description": "Detection of handwritten marginalia, numeric corrections, or status stamps."
      },
      "PipelineResult": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "classification": {
            "$ref": "#/components/schemas/ClassificationResult"
          },
          "extracted": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Extracted"
          },
          "field_sources": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SourceLocation"
            },
            "type": "object",
            "title": "Field Sources",
            "description": "Where each extracted field was read from — kept beside the data, not inside it."
          },
          "extract_attempts": {
            "type": "integer",
            "title": "Extract Attempts"
          },
          "validation_issues": {
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "type": "array",
            "title": "Validation Issues"
          },
          "ocr_method": {
            "type": "string",
            "title": "Ocr Method"
          },
          "raw_text_chars": {
            "type": "integer",
            "title": "Raw Text Chars"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "unknown"
          },
          "escalated_to_vlm": {
            "type": "boolean",
            "title": "Escalated To Vlm",
            "default": false
          },
          "needs_review": {
            "type": "boolean",
            "title": "Needs Review",
            "default": false
          },
          "review_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Review Reasons"
          },
          "llm_calls": {
            "type": "integer",
            "title": "Llm Calls",
            "default": 0
          },
          "llm_estimated_tokens": {
            "type": "integer",
            "title": "Llm Estimated Tokens",
            "default": 0
          },
          "pages_total": {
            "type": "integer",
            "title": "Pages Total",
            "default": 1
          },
          "pages_processed": {
            "type": "integer",
            "title": "Pages Processed",
            "default": 1
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": true
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "page_methods": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Page Methods"
          },
          "forensic_report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DocumentForensicReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "source",
          "classification",
          "extracted",
          "extract_attempts",
          "ocr_method",
          "raw_text_chars"
        ],
        "title": "PipelineResult"
      },
      "ReviewUpdate": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "corrections": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrections"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "reviewer"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ReviewUpdate"
      },
      "SignatureDetection": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "1-indexed page number where signature was found."
          },
          "box": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Box",
            "description": "Normalized bounding box (ymin, xmin, ymax, xmax) from 0.0 to 1.0."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Signature detection confidence score.",
            "default": 1.0
          },
          "signatory_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signatory Label",
            "description": "Contextual role (e.g. Customer, Contractor, Director) if labeled."
          }
        },
        "type": "object",
        "required": [
          "page",
          "box"
        ],
        "title": "SignatureDetection",
        "description": "Detection of a handwritten signature, mark, or cursive endorsement."
      },
      "SourceLocation": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "title": "Quote",
            "description": "Exact text copied from the source page."
          }
        },
        "type": "object",
        "required": [
          "page",
          "quote"
        ],
        "title": "SourceLocation",
        "description": "Auditable link from a field to the original page region."
      },
      "StampDetection": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page",
            "description": "1-indexed page number where stamp was found."
          },
          "box": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Box",
            "description": "Normalized bounding box (ymin, xmin, ymax, xmax) from 0.0 to 1.0."
          },
          "color": {
            "type": "string",
            "title": "Color",
            "description": "Dominant ink color (e.g. blue, violet, red, black).",
            "default": "blue"
          },
          "shape": {
            "type": "string",
            "title": "Shape",
            "description": "Geometry of the stamp (circular, oval, rectangular, irregular).",
            "default": "circular"
          },
          "confidence": {
            "type": "number",
