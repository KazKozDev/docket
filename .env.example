# LLM backend: "ollama" (local or Ollama cloud) or "openai" (any
# OpenAI-compatible endpoint — Mistral, OpenAI, Azure OpenAI, vLLM, LM Studio).
DOCKET_LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# For DOCKET_LLM_PROVIDER=openai, e.g. Mistral (EU-hosted):
# DOCKET_LLM_BASE_URL=https://api.mistral.ai/v1
# DOCKET_LLM_API_KEY=
# DOCKET_TEXT_MODEL=mistral-small-latest
# DOCKET_VISION_MODEL=pixtral-12b-latest
DOCKET_TEXT_MODEL=deepseek-v4.1-flash:cloud
DOCKET_VISION_MODEL=deepseek-v4.1-flash:cloud
DOCKET_MAX_EXTRACT_RETRIES=2
DOCKET_EXTRACT_CHUNK_CHARS=12000

# OCR chain: primary backend ("auto" = first installed of tesseract, paddle),
# then fallbacks tried in order when a page's reading is rejected.
DOCKET_OCR_BACKEND=auto
DOCKET_OCR_FALLBACKS=vlm
# ISO 639-1 codes, comma-separated; install the matching Tesseract packs.
DOCKET_OCR_LANGUAGES=en
# A page reading is accepted at or above this confidence (0..1).
DOCKET_OCR_MIN_CONFIDENCE=0.60
DOCKET_OCR_DETECT_ROTATION=true

# Reasoning models deliberate before answering. Transcribing fields off a page
# has nothing to deliberate about, so thinking is off by default — it was 18x
# slower end-to-end with it on, for the same answer. Set to true to re-enable.
DOCKET_ENABLE_THINKING=false

# Routing thresholds
DOCKET_TFIDF_CONFIDENCE_FLOOR=0.65
DOCKET_MIN_CONFIDENCE=0.55

# Human-review queue (set ENABLED=false when your app runs its own review flow)
DOCKET_REVIEW_QUEUE_ENABLED=true
DOCKET_REVIEW_QUEUE=data/review_queue.jsonl
DOCKET_REVIEW_DOCUMENTS=data/review_documents

# Service safety and durable jobs
DOCKET_MAX_FILE_BYTES=20971520
DOCKET_MAX_PDF_PAGES=100
DOCKET_MAX_CONCURRENT_JOBS=2
DOCKET_JOB_STORE=data/jobs.json
DOCKET_JOB_UPLOADS=data/job_uploads
# DOCKET_API_KEY=replace-me

# Illustrative hosted-model rate for eval cost reporting. This is not billing data.
DOCKET_CLOUD_COST_PER_1M_TOKENS=0.20

# Optional Langfuse tracing — leave unset to keep everything local.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
